{name === 'cricket' && <svg {...s} class={cls} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14.5 3.5l6 6-9 9-6-6z"/><path d="M5.5 12.5l-2 2a2 2 0 0 0 0 3l1 1a2 2 0 0 0 3 0l2-2"/><circle cx="18" cy="6" r="1"/></svg>}
