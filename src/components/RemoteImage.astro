---
import { u } from '../data/images';
interface Props {
  id: string;
  alt: string;
  w?: number;
  h?: number;
  class?: string;
  eager?: boolean;
  sizes?: string;
}
const { id, alt, w = 1200, h, class: cls = '', eager = false, sizes } = Astro.props;
const src = u(id, w);
// Two self-hosted widths exist per image (640, 1280)
const srcset = `${u(id, 640)} 640w, ${u(id, 1280)} 1280w`;
---
<img
  src={src}
  srcset={srcset}
  sizes={sizes || `(max-width: 700px) 100vw, ${w}px`}
  alt={alt}
  width={w}
  height={h || Math.round(w * 0.66)}
  loading={eager ? 'eager' : 'lazy'}
  decoding="async"
  class={`remote-img ${cls}`}
/>
<style>
  .remote-img { width: 100%; height: 100%; object-fit: cover; background: var(--surface-2); display: block; }
</style>
