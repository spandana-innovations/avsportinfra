---
import Icon from './Icon.astro';
import { whatsappLink } from '../data/site';
import { pageImages, u } from '../data/images';
interface Props { heading?: string; sub?: string; prefill?: string; }
const {
  heading = "Planning a sports facility? Let's build it right.",
  sub = 'Tell us your sport, site and timeline — we’ll return a layout and a fixed quote.',
  prefill = '',
} = Astro.props;
---
<section class="cta-band" data-reveal>
  <div class="container inner">
    <img class="cta-bg" src={u(pageImages.cta, 1600, 700)} alt="" aria-hidden="true" loading="lazy" />
    <div class="glow" aria-hidden="true"></div>
    <div class="cta-copy">
      <p class="eyebrow">Get Started</p>
      <h2 class="section-title">{heading}</h2>
      <p class="lead">{sub}</p>
    </div>
    <div class="cta-actions">
      <a href="/contact" class="btn btn-primary btn-lg">Get a Free Quotation</a>
      <a href={whatsappLink(prefill)} class="btn btn-wa btn-lg" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Chat on WhatsApp</a>
    </div>
  </div>
</section>
<style>
  .cta-band { padding-block: clamp(2rem, 4vw, 3rem); }
  .inner { position: relative; overflow: hidden; background: linear-gradient(120deg, var(--forest) 0%, var(--forest-700) 55%, #0c5e2e 100%); border-radius: var(--radius-lg); padding: clamp(2rem, 4vw, 3.4rem); display: flex; align-items: center; justify-content: space-between; gap: 2rem; flex-wrap: wrap; box-shadow: var(--shadow-lg); }
  .cta-copy { position: relative; z-index: 1; }
  .inner .eyebrow { color: var(--grass-300); }
  .inner h2 { color: #fff; max-width: 20ch; }
  .inner .lead { color: #cfe6d4; }
  .cta-actions { display: flex; gap: 0.8rem; flex-wrap: wrap; position: relative; z-index: 1; }
  .cta-bg { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.2; z-index: 0; mix-blend-mode: luminosity; }
  .glow { position: absolute; width: 420px; height: 420px; right: -120px; top: -160px; background: radial-gradient(circle, rgba(68,192,26,0.45), transparent 65%); filter: blur(10px); z-index: 0; }
  @media (max-width: 700px) { .cta-actions .btn { flex: 1 1 100%; justify-content: center; } }
</style>
