---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav, whatsappLink } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="AV Sports and Infrastructure — home">
      <Logo height={44} />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {mainNav.map((item) => (
          <li class={item.children ? 'has-children' : ''}>
            <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
              {item.label}{item.children && <Icon name="chevron" size={15} class="chev" />}
            </a>
            {item.children && (
              <div class="dropdown">
                <ul>
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <Icon name="sun" size={20} class="i-sun" />
        <Icon name="moon" size={20} class="i-moon" />
      </button>
      <a href={whatsappLink()} class="btn btn-wa wa-btn" target="_blank" rel="noopener" aria-label="Chat on WhatsApp">
        <Icon name="whatsapp" size={18} /><span>WhatsApp</span>
      </a>
      <a href="/contact" class="btn btn-primary quote-btn">Get a Quotation</a>
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false">
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

  <!-- Mobile drawer -->
  <div class="mobile-drawer" id="mobile-drawer" hidden>
    <nav aria-label="Mobile">
      <ul>
        {mainNav.map((item) => (
          <li>
            <a href={item.href}>{item.label}</a>
            {item.children && (
              <ul class="sub">
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            )}
          </li>
        ))}
      </ul>
      <div class="drawer-cta">
        <a href={whatsappLink()} class="btn btn-wa" target="_blank" rel="noopener"><Icon name="whatsapp" size={18} /> Chat on WhatsApp</a>
        <a href="/contact" class="btn btn-primary">Get a Free Quotation</a>
      </div>
    </nav>
  </div>
</header>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--header-bg); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); border-bottom: 1px solid transparent; transition: border-color 0.3s var(--ease), background 0.3s var(--ease), box-shadow 0.3s var(--ease); }
  .site-header.scrolled { border-bottom-color: var(--border); box-shadow: var(--shadow); }
  .bar { display: flex; align-items: center; gap: 1.2rem; min-height: 76px; }
  .site-header.scrolled .bar { min-height: 64px; }
  .bar { transition: min-height 0.3s var(--ease); }
  .brand { flex-shrink: 0; }

  .desktop-nav { margin-left: auto; }
  .desktop-nav > ul { display: flex; align-items: center; gap: 0.3rem; list-style: none; padding: 0; }
  .desktop-nav a { display: inline-flex; align-items: center; gap: 0.2rem; padding: 0.55rem 0.8rem; border-radius: 10px; font-weight: 600; font-size: 0.95rem; color: var(--text); transition: color 0.2s, background 0.2s; }
  .desktop-nav a:hover { color: var(--grass-600); background: color-mix(in srgb, var(--grass) 10%, transparent); }
  :root[data-theme='dark'] .desktop-nav a:hover { color: var(--grass-300); }
  .desktop-nav a.active { color: var(--grass-600); }
  :root[data-theme='dark'] .desktop-nav a.active { color: var(--grass-300); }
  .chev { opacity: 0.6; transition: transform 0.2s; }
  .has-children { position: relative; }
  .has-children:hover .chev { transform: rotate(180deg); }
  .dropdown { position: absolute; top: calc(100% + 8px); left: 50%; transform: translateX(-50%) translateY(8px); min-width: 250px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-lg); padding: 0.5rem; opacity: 0; visibility: hidden; transition: opacity 0.22s var(--ease), transform 0.22s var(--ease); }
  .has-children:hover .dropdown, .has-children:focus-within .dropdown { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .dropdown ul { list-style: none; padding: 0; margin: 0; }
  .dropdown a { padding: 0.6rem 0.8rem; border-radius: 10px; font-size: 0.92rem; font-weight: 500; }

  .header-actions { display: flex; align-items: center; gap: 0.6rem; margin-left: 0.4rem; }
  .theme-toggle { width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--text); display: grid; place-items: center; position: relative; transition: border-color 0.2s, transform 0.2s; }
  .theme-toggle:hover { border-color: var(--grass); transform: translateY(-1px); }
  .theme-toggle .i-moon { display: none; }
  :root[data-theme='dark'] .theme-toggle .i-sun { display: none; }
  :root[data-theme='dark'] .theme-toggle .i-moon { display: block; }

  .menu-btn { display: none; width: 42px; height: 42px; border-radius: 12px; border: 1px solid var(--border); background: var(--surface); color: var(--text); place-items: center; }

  .mobile-drawer { display: none; }

  @media (max-width: 1024px) {
    .desktop-nav, .wa-btn span { display: none; }
    .wa-btn { padding: 0.7rem; }
    .quote-btn { display: none; }
    .menu-btn { display: grid; }
    .mobile-drawer { display: block; position: fixed; inset: 0 0 0 auto; width: min(86vw, 360px); background: var(--bg-elev); border-left: 1px solid var(--border); box-shadow: var(--shadow-lg); padding: 1.5rem 1.3rem 2rem; overflow-y: auto; transform: translateX(100%); transition: transform 0.35s var(--ease); z-index: 130; top: 0; height: 100dvh; }
    .mobile-drawer.open { transform: translateX(0); }
    .mobile-drawer[hidden] { display: block; }
    .mobile-drawer nav > ul { list-style: none; padding: 0; margin: 4rem 0 0; }
    .mobile-drawer nav > ul > li { border-bottom: 1px solid var(--border); }
    .mobile-drawer nav > ul > li > a { display: block; padding: 0.9rem 0.2rem; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: 1.05rem; }
    .mobile-drawer .sub { list-style: none; padding: 0 0 0.8rem 0.6rem; margin: 0; }
    .mobile-drawer .sub a { display: block; padding: 0.4rem 0; color: var(--text-soft); font-size: 0.95rem; }
    .drawer-cta { display: grid; gap: 0.7rem; margin-top: 1.5rem; }
    .drawer-cta .btn { justify-content: center; }
  }
  @media (max-width: 460px) { .quote-btn { display: none; } }
</style>

<div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
<style>
  .drawer-backdrop { position: fixed; inset: 0; background: rgba(2, 14, 7, 0.5); z-index: 120; opacity: 0; transition: opacity 0.3s; }
  .drawer-backdrop.show { opacity: 1; }
</style>

<script>
  // Sticky shrink
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });

  // Mobile drawer
  const menuBtn = document.getElementById('menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const openMenu = (open: boolean) => {
    drawer?.classList.toggle('open', open);
    backdrop?.toggleAttribute('hidden', !open);
    requestAnimationFrame(() => backdrop?.classList.toggle('show', open));
    menuBtn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  menuBtn?.addEventListener('click', () => openMenu(!drawer?.classList.contains('open')));
  backdrop?.addEventListener('click', () => openMenu(false));
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => openMenu(false)));
</script>
