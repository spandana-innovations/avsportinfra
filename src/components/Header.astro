---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { mainNav } from '../data/site';
const path = Astro.url.pathname;
const isActive = (href: string) => href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header" id="site-header">
  <div class="container bar">
    <a href="/" class="brand" aria-label="AV Sports and Infrastructure, home">
      <Logo height={52} />
    </a>

    <nav class="desktop-nav" aria-label="Primary">
      <ul>
        {mainNav.map((item) => (
          <li class={item.children ? 'has-children' : ''}>
            {item.icon && !item.children ? (
              <a href={item.href} class={`nav-ic ${isActive(item.href) ? 'active' : ''}`} title={item.label} aria-label={item.label} aria-current={isActive(item.href) ? 'page' : undefined}>
                <Icon name={item.icon} size={24} />
              </a>
            ) : (
              <a href={item.href} class={isActive(item.href) ? 'active' : ''} aria-current={isActive(item.href) ? 'page' : undefined}>
                {item.label}{item.children && <Icon name="chevron" size={15} class="chev" />}
              </a>
            )}
            {item.children && (
              <div class="dropdown">
                <ul>
                  {item.children.map((c) => (
                    <li><a href={c.href}>{c.label}</a></li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>
    </nav>

    <div class="header-actions">
      <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode" title="Toggle theme">
        <Icon name="sun" size={20} class="i-sun" />
        <Icon name="moon" size={20} class="i-moon" />
      </button>
      <a href="/contact" class="btn btn-primary quote-btn">Get a Quotation</a>
      <button class="menu-btn" id="menu-btn" type="button" aria-label="Open menu" aria-expanded="false">
        <Icon name="menu" size={26} />
      </button>
    </div>
  </div>

</header>

<!-- Mobile drawer: kept OUTSIDE <header> so the header's sticky stacking context
     doesn't trap it beneath the full-screen backdrop (which blocked taps). -->
<div class="mobile-drawer" id="mobile-drawer" hidden>
  <nav aria-label="Mobile">
    <p class="drawer-label">Menu</p>
    <ul>
      {mainNav.map((item) => (
        <li>
          {item.children ? (
            <details class="m-acc">
              <summary>
                <span class="mi-label">{item.label}</span>
                <Icon name="chevron" size={18} class="mi-chev" />
              </summary>
              <ul class="m-sub">
                <li><a href={item.href}>All {item.label}</a></li>
                {item.children.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
              </ul>
            </details>
          ) : (
            <a href={item.href} class={isActive(item.href) ? 'active' : ''}>
              <span class="mi-label">{item.icon && <Icon name={item.icon} size={19} />}{item.label}</span>
              <Icon name="arrow" size={18} class="mi-arrow" />
            </a>
          )}
        </li>
      ))}
    </ul>
    <div class="drawer-cta">
      <a href="/contact" class="btn btn-primary btn-lg">Get a Free Quotation</a>
    </div>
  </nav>
</div>

<style>
  .site-header { position: sticky; top: 0; z-index: 100; background: var(--header-bg); backdrop-filter: saturate(1.4) blur(14px); -webkit-backdrop-filter: saturate(1.4) blur(14px); border-bottom: 1px solid transparent; transition: border-color 0.3s var(--ease), background 0.3s var(--ease), box-shadow 0.3s var(--ease); }
  .site-header.scrolled { border-bottom-color: var(--border); box-shadow: var(--shadow); }
  .bar { display: flex; align-items: center; gap: 1.2rem; min-height: 96px; }
  .site-header.scrolled .bar { min-height: 78px; }
  .brand { padding-block: 10px; }
  @media (max-width: 1024px) { .bar { min-height: 66px; } .site-header.scrolled .bar { min-height: 60px; } .brand { padding-block: 4px; } }
  .bar { transition: min-height 0.3s var(--ease); }
  .brand { flex-shrink: 0; }

  .desktop-nav { margin-left: auto; }
  .desktop-nav > ul { display: flex; align-items: center; gap: 0.3rem; list-style: none; padding: 0; }
  .desktop-nav a { display: inline-flex; align-items: center; gap: 0.2rem; padding: 0.55rem 0.8rem; border-radius: 10px; font-weight: 600; font-size: 0.95rem; color: var(--text); transition: color 0.2s, background 0.2s; }
  .desktop-nav a:hover { color: var(--grass-600); background: color-mix(in srgb, var(--grass) 10%, transparent); }
  :root[data-theme='dark'] .desktop-nav a:hover { color: var(--grass-300); }
  .desktop-nav a.active { color: var(--grass-600); }
  :root[data-theme='dark'] .desktop-nav a.active { color: var(--grass-300); }
  .desktop-nav .nav-ic { justify-content: center; color: var(--grass-600); padding: 0.45rem 0.55rem; }
  .nav-ic :global(svg) { width: 24px; height: 24px; }
  .desktop-nav .nav-ic:hover { color: var(--grass); background: color-mix(in srgb, var(--grass) 12%, transparent); }
  :root[data-theme='dark'] .desktop-nav .nav-ic { color: var(--grass-300); }
  :global(.chev) { opacity: 0.6; transition: transform 0.2s; }
  .has-children { position: relative; }
  .has-children:hover :global(.chev) { transform: rotate(180deg); }
  .dropdown { position: absolute; top: calc(100% + 6px); left: 50%; transform: translateX(-50%) translateY(8px); min-width: 250px; background: var(--surface); border: 1px solid var(--border); border-radius: 16px; box-shadow: var(--shadow-lg); padding: 0.5rem; opacity: 0; visibility: hidden; transition: opacity 0.22s var(--ease), transform 0.22s var(--ease); }
  /* invisible hover bridge so the cursor can cross the gap into the menu */
  .dropdown::before { content: ''; position: absolute; left: 0; right: 0; top: -12px; height: 14px; }
  .has-children:hover .dropdown, .has-children:focus-within .dropdown { opacity: 1; visibility: visible; transform: translateX(-50%) translateY(0); }
  .dropdown ul { list-style: none; padding: 0; margin: 0; }
  .dropdown a { padding: 0.6rem 0.8rem; border-radius: 10px; font-size: 0.92rem; font-weight: 500; }

  .header-actions { display: flex; align-items: center; gap: 0.5rem; margin-left: 0.4rem; }
  .quote-btn { padding: 0.55rem 1.2rem; font-size: 0.82rem; white-space: nowrap; }
  /* Big brand logo (104px via prop), scaled down on smaller screens */
  @media (max-width: 1024px) { .brand :global(.logo img) { height: 42px !important; } }
  @media (max-width: 560px) { .brand :global(.logo img) { height: 38px !important; } }
  .theme-toggle { width: 42px; height: 42px; border: none; background: transparent; color: var(--text); display: grid; place-items: center; transition: color 0.2s, transform 0.2s; }
  .theme-toggle:hover { color: var(--grass-600); transform: translateY(-1px); }
  :root[data-theme='dark'] .theme-toggle:hover { color: var(--grass-300); }
  /* Light mode shows the moon (tap → dark); dark mode shows the sun (tap → light) */
  .theme-toggle :global(.i-sun) { display: none; }
  .theme-toggle :global(.i-moon) { display: block; }
  :root[data-theme='dark'] .theme-toggle :global(.i-moon) { display: none; }
  :root[data-theme='dark'] .theme-toggle :global(.i-sun) { display: block; }

  .menu-btn { display: none; width: 44px; height: 44px; border: none; background: transparent; color: var(--text); place-items: center; }

  .mobile-drawer { display: none; }

  @media (max-width: 1024px) {
    .desktop-nav { display: none; }
    .quote-btn { display: none; }
    .header-actions { margin-left: auto; gap: 0.25rem; }
    .menu-btn { display: grid; }
    .mobile-drawer { display: block; position: fixed; inset: 0 0 0 auto; width: min(86vw, 360px); background: var(--bg-elev); border-left: 1px solid var(--border); box-shadow: var(--shadow-lg); padding: 1.5rem 1.3rem 2rem; overflow-y: auto; transform: translateX(100%); transition: transform 0.35s var(--ease); z-index: 130; top: 0; height: 100dvh; }
    .mobile-drawer.open { transform: translateX(0); }
    .mobile-drawer[hidden] { display: block; }
    .drawer-label { margin: 3.4rem 0 0.4rem; font-family: var(--font-display); text-transform: uppercase; letter-spacing: 0.16em; font-size: 0.72rem; color: var(--muted); }
    .mobile-drawer nav > ul { list-style: none; padding: 0; margin: 0; }
    .mobile-drawer nav > ul > li { border-bottom: 1px solid var(--border); }
    .mobile-drawer nav > ul > li > a { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 1.05rem 0.2rem; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: 1.1rem; color: var(--text); transition: color 0.2s, padding 0.2s; }
    .mobile-drawer .mi-label { display: inline-flex; align-items: center; gap: 0.7rem; }
    .mobile-drawer :global(.mi-arrow) { opacity: 0; transform: translateX(-6px); transition: opacity 0.2s, transform 0.2s; color: var(--grass-600); flex-shrink: 0; }
    .mobile-drawer nav > ul > li > a:hover, .mobile-drawer nav > ul > li > a.active { color: var(--grass-600); padding-left: 0.5rem; }
    :root[data-theme='dark'] .mobile-drawer nav > ul > li > a:hover, :root[data-theme='dark'] .mobile-drawer nav > ul > li > a.active { color: var(--grass-300); }
    .mobile-drawer nav > ul > li > a:hover :global(.mi-arrow), .mobile-drawer nav > ul > li > a.active :global(.mi-arrow) { opacity: 1; transform: none; }
    :root[data-theme='dark'] .mobile-drawer :global(.mi-arrow) { color: var(--grass-300); }
    .m-acc summary { display: flex; align-items: center; justify-content: space-between; gap: 0.8rem; padding: 1.05rem 0.2rem; font-family: var(--font-display); font-weight: 700; text-transform: uppercase; font-size: 1.1rem; color: var(--text); cursor: pointer; list-style: none; }
    .m-acc summary::-webkit-details-marker { display: none; }
    .m-acc :global(.mi-chev) { color: var(--muted); transition: transform 0.25s; flex-shrink: 0; }
    .m-acc[open] > summary { color: var(--grass-600); }
    :root[data-theme='dark'] .m-acc[open] > summary { color: var(--grass-300); }
    .m-acc[open] > summary :global(.mi-chev) { transform: rotate(180deg); }
    .m-sub { list-style: none; padding: 0 0 0.7rem 0.3rem; margin: 0; }
    .m-sub li { border: none; }
    .m-sub a { display: block; padding: 0.5rem 0; color: var(--text-soft); font-size: 0.98rem; font-weight: 500; }
    .m-sub a:hover { color: var(--grass-600); }
    :root[data-theme='dark'] .m-sub a:hover { color: var(--grass-300); }
    .drawer-cta { display: grid; gap: 0.7rem; margin-top: 1.8rem; }
    .drawer-cta .btn { justify-content: center; }
  }
  @media (max-width: 460px) { .quote-btn { display: none; } }
</style>

<div class="drawer-backdrop" id="drawer-backdrop" hidden></div>
<style>
  .drawer-backdrop { position: fixed; inset: 0; background: rgba(2, 14, 7, 0.5); z-index: 120; opacity: 0; transition: opacity 0.3s; }
  .drawer-backdrop.show { opacity: 1; }
</style>

<script>
  // Sticky shrink
  const header = document.getElementById('site-header');
  const onScroll = () => header?.classList.toggle('scrolled', window.scrollY > 10);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Theme toggle
  const toggle = document.getElementById('theme-toggle');
  toggle?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });

  // Mobile drawer
  const menuBtn = document.getElementById('menu-btn');
  const drawer = document.getElementById('mobile-drawer');
  const backdrop = document.getElementById('drawer-backdrop');
  const openMenu = (open: boolean) => {
    drawer?.classList.toggle('open', open);
    backdrop?.toggleAttribute('hidden', !open);
    requestAnimationFrame(() => backdrop?.classList.toggle('show', open));
    menuBtn?.setAttribute('aria-expanded', String(open));
    document.body.style.overflow = open ? 'hidden' : '';
  };
  menuBtn?.addEventListener('click', () => openMenu(!drawer?.classList.contains('open')));
  backdrop?.addEventListener('click', () => openMenu(false));
  drawer?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => openMenu(false)));
</script>
