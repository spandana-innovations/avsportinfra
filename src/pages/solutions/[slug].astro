---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import CTABand from '../../components/CTABand.astro';
import { solutions, services, whatsappLink } from '../../data/site';
import { serviceImages, u } from '../../data/images';

export function getStaticPaths() {
  return solutions.map((s) => ({ params: { slug: s.slug }, props: { sol: s } }));
}
const { sol } = Astro.props;
const picks = services.slice(0, 6);
const breadcrumb = {
  '@context': 'https://schema.org', '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.avsportsinfrastructure.com/' },
    { '@type': 'ListItem', position: 2, name: 'Solutions', item: 'https://www.avsportsinfrastructure.com/solutions' },
    { '@type': 'ListItem', position: 3, name: sol.title },
  ],
};
---
<Base
  title={`${sol.h1} | AV Sports and Infrastructure`}
  description={sol.angle + ' Built across India by AV Sports and Infrastructure.'}
  path={`/solutions/${sol.slug}`}
  jsonLd={breadcrumb}
>
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"><img class="hero-fade" src={u(serviceImages['football-turf'][0], 1600, 700)} alt="" /><div class="hero-glow"></div></div>
    <div class="container">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> <span>/</span> <a href="/solutions">Solutions</a> <span>/</span> <span class="current">{sol.title}</span></nav>
      <h1 class="h-display" data-reveal data-delay="1">{sol.h1}</h1>
      <p class="lead" data-reveal data-delay="2">{sol.angle}</p>
      <div data-reveal data-delay="3" class="sol-cta">
        <a href="/contact" class="btn btn-primary btn-lg">Get a Free Quotation</a>
        <a href={whatsappLink(sol.title + ' — ')} class="btn btn-ghost btn-lg" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> WhatsApp Us</a>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">Relevant Services</p>
        <h2 class="section-title">What we typically build for {sol.title.toLowerCase()}</h2>
      </div>
      <div class="grid cols-3">
        {picks.map((s, i) => (
          <a class="card" href={`/services/${s.slug}`} data-reveal data-delay={i % 3}>
            <span class="icon-badge"><Icon name={s.icon} size={24} /></span>
            <h3>{s.title}</h3>
            <p>{s.short}</p>
            <span class="arrow">Explore <Icon name="arrow" size={16} /></span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand prefill={sol.title + ' — '} />
</Base>

<style>
  .page-hero { position: relative; overflow: hidden; color: #fff; padding-block: clamp(2.6rem, 6vw, 4.5rem); }
  .page-hero-bg { position: absolute; inset: 0; z-index: -1; background: linear-gradient(135deg, var(--forest), var(--forest-700) 60%, #0a5027); }
  :root[data-theme='dark'] .page-hero-bg { background: linear-gradient(135deg, #021a0c, #073018 60%, #0a4020); }
  .page-hero .hero-glow { position: absolute; width: 480px; height: 480px; right: -120px; top: -160px; background: radial-gradient(circle, rgba(68,192,26,0.4), transparent 62%); filter: blur(14px); }
  .crumbs { font-size: 0.85rem; color: #bfdcc5; margin-bottom: 1.4rem; }
  .crumbs a:hover { color: var(--grass-300); }
  .crumbs .current { color: #fff; }
  .page-hero h1 { color: #fff; margin-bottom: 1rem; }
  .page-hero .lead { color: #d7ecdb; max-width: 62ch; margin-bottom: 1.6rem; }
  .sol-cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  .sol-cta .btn-ghost { color: #fff; border-color: rgba(255,255,255,0.35); }
  .sol-cta .btn-ghost:hover { background: rgba(68,192,26,0.16); border-color: var(--grass); }
  .card h3 { text-transform: none; }
</style>
