---
import Base from '../layouts/Base.astro';
import { site } from '../data/site';
---
<Base title="Privacy Policy" description="Privacy policy for AV Sports and Infrastructure." path="/privacy" noindex={true}>
  <section class="section">
    <div class="container prose">
      <h1 class="section-title">Privacy Policy</h1>
      <p class="muted">Last updated: [DATE] — this is a starter template; have it reviewed before launch.</p>
      <p>{site.name} ("we", "us") respects your privacy. This policy explains what information we collect and how we use it.</p>
      <h2>Information we collect</h2>
      <p>When you submit an enquiry or quotation request, we collect the details you provide — such as your name, phone number, email, city and project details — solely to respond to your enquiry.</p>
      <h2>How we use it</h2>
      <p>We use your information to prepare quotations, arrange site visits and communicate about your project. We do not sell your data.</p>
      <h2>Contact</h2>
      <p>For any privacy questions, contact us at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
    </div>
  </section>
</Base>
<style>
  .prose { max-width: 70ch; }
  .prose h2 { font-size: 1.3rem; margin: 2rem 0 0.6rem; }
  .prose p { color: var(--text-soft); margin-bottom: 1rem; }
  .prose .muted { color: var(--muted); font-size: 0.9rem; }
  .prose a { color: var(--grass-600); font-weight: 600; }
</style>
