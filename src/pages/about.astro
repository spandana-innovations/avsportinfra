---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import CTABand from '../components/CTABand.astro';
import RemoteImage from '../components/RemoteImage.astro';
import { whyUs, stats } from '../data/site';
import { pageImages, u } from '../data/images';
---
<Base
  title="About AV Sports and Infrastructure | Sports Ground Builders"
  description="AV Sports and Infrastructure is a turnkey sports-infrastructure company delivering FIFA-standard turfs, courts and tracks across India. Learn about our work."
  path="/about"
>
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"><img class="hero-fade" src={u(pageImages.aboutHero, 1600, 700)} alt="" /><div class="hero-glow"></div></div>
    <div class="container">
      <p class="pill" data-reveal><Icon name="shield" size={15} /> About Us</p>
      <h1 class="h-display" data-reveal data-delay="1">Engineering India's Sports Surfaces, End to End</h1>
      <p class="lead" data-reveal data-delay="2">Surfaces that play true, drain fast and last seasons, not months. From football turfs to full multi-sport complexes, we handle design, civil work, surfacing and handover under one roof.</p>
    </div>
  </section>

  <section class="section">
    <div class="container about-grid">
      <div data-reveal>
        <p class="eyebrow">Our Story</p>
        <h2 class="section-title">Built on engineering, not shortcuts</h2>
        <p>AV Sports and Infrastructure was founded to raise the standard of sports facilities in India. We believe a great surface starts underground, with the right base, grading and drainage, and only then with premium surfacing on top.</p>
        <p>Today we deliver football turfs, courts, running tracks and complete turnkey complexes across the country, with a single team accountable from first survey to play-ready handover.</p>
        <p class="muted-note">Expand with your founding year, founder note and a flagship milestone.</p>
      </div>
      <div class="about-img" data-reveal data-delay="1"><RemoteImage id={pageImages.about} alt="Aerial view of a sports complex built by AV Sports and Infrastructure" w={720} h={560} /></div>
    </div>
  </section>

  <section class="stats-strip">
    <div class="container grid cols-4">
      {stats.map((s, i) => (
        <div class="stat" data-reveal data-delay={i}>
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">Why Clients Choose Us</p>
        <h2 class="section-title">A partner you can rely on</h2>
      </div>
      <div class="grid cols-4">
        {whyUs.map((w, i) => (
          <div class="card" data-reveal data-delay={i}>
            <span class="icon-badge"><Icon name="check" size={22} /></span>
            <h3>{w.title}</h3>
            <p>{w.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section standards">
    <div class="container">
      <div class="std-card" data-reveal>
        <div>
          <p class="eyebrow">Standards &amp; Materials</p>
          <h2 class="section-title">International benchmarks, warranty-backed</h2>
          <p class="lead">We build to published performance benchmarks, FIFA Quality / Quality Pro for football, ITF pace ratings for tennis, and IAAF-aligned specifications for athletic tracks. Turf, infill, acrylics and EPDM come from established manufacturers with warranties.</p>
        </div>
        <div class="std-badges">
          <span class="pill">FIFA Quality</span>
          <span class="pill">ITF Rated</span>
          <span class="pill">IAAF-Aligned</span>
          <span class="pill">Warranty-Backed</span>
        </div>
      </div>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .page-hero { position: relative; overflow: hidden; color: #fff; padding-block: clamp(2.6rem, 6vw, 4.5rem); }
  .page-hero-bg { position: absolute; inset: 0; z-index: -1; background: linear-gradient(135deg, var(--forest), var(--forest-700) 60%, #0a5027); }
  :root[data-theme='dark'] .page-hero-bg { background: linear-gradient(135deg, #021a0c, #073018 60%, #0a4020); }
  .page-hero .hero-glow { position: absolute; width: 480px; height: 480px; right: -120px; top: -160px; background: radial-gradient(circle, rgba(68,192,26,0.4), transparent 62%); filter: blur(14px); }
  .page-hero .pill { background: rgba(255,255,255,0.12); color: #cdebc0; margin-bottom: 1.2rem; }
  .page-hero h1 { color: #fff; margin-bottom: 1rem; max-width: 20ch; }
  .page-hero .lead { color: #d7ecdb; max-width: 64ch; }

  .about-grid { display: grid; grid-template-columns: 1.1fr 0.9fr; gap: clamp(1.5rem, 4vw, 3rem); align-items: center; }
  .about-grid h2 { margin-bottom: 1rem; }
  .about-grid p { color: var(--text-soft); margin-bottom: 1rem; }
  .muted-note { font-size: 0.85rem; color: var(--muted); font-style: italic; }
  .about-img { min-height: 320px; height: 100%; border-radius: var(--radius-lg); overflow: hidden; box-shadow: var(--shadow); }
  .about-img :global(.remote-img) { min-height: 320px; }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; } }

  .stats-strip { background: var(--forest); color: #fff; }
  :root[data-theme='dark'] .stats-strip { background: var(--surface-2); }
  .stats-strip .container { padding-block: clamp(1.6rem, 3vw, 2.4rem); }
  .stat { text-align: center; border-right: 1px solid rgba(255,255,255,0.14); }
  .stat:last-child { border-right: none; }
  :root[data-theme='dark'] .stat { border-color: var(--border); }
  .stat-value { display: block; font-family: var(--font-display); font-weight: 900; font-size: clamp(2rem, 4vw, 3rem); color: var(--grass-300); line-height: 1; }
  .stat-label { display: block; margin-top: 0.4rem; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: #cfe0d2; }
  :root[data-theme='dark'] .stat-label { color: var(--text-soft); }
  @media (max-width: 620px) { .stat { border-right: none; } }

  .card h3 { text-transform: none; margin-bottom: 0.3rem; font-size: 1.1rem; }
  .standards { background: var(--surface-2); }
  .std-card { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: clamp(1.8rem, 4vw, 3rem); box-shadow: var(--shadow); display: grid; grid-template-columns: 1.4fr 0.6fr; gap: 2rem; align-items: center; }
  .std-card .lead { color: var(--text-soft); }
  .std-badges { display: flex; flex-wrap: wrap; gap: 0.6rem; }
  @media (max-width: 760px) { .std-card { grid-template-columns: 1fr; } }
</style>
