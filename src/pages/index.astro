---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import ServiceCard from '../components/ServiceCard.astro';
import CTABand from '../components/CTABand.astro';
import RemoteImage from '../components/RemoteImage.astro';
import { site, services, stats, whyUs, processSteps, whatsappLink } from '../data/site';
import { pageImages, serviceImages, u } from '../data/images';

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: [
    { '@type': 'Question', name: 'What does AV Sports and Infrastructure build?', acceptedAnswer: { '@type': 'Answer', text: 'Football turfs, FIFA-standard grounds, futsal courts, cricket turf and nets, pickleball/basketball/tennis/badminton courts, running tracks, EPDM flooring, drainage, fencing, floodlighting and complete turnkey sports facilities across India.' } },
    { '@type': 'Question', name: 'Do you work across India?', acceptedAnswer: { '@type': 'Answer', text: 'Yes. We are based in ' + site.city + ' and deliver sports-infrastructure projects PAN-India.' } },
  ],
};
---
<Base
  title="Sports Infrastructure Company in India"
  description="AV Sports and Infrastructure builds FIFA-standard football turfs, courts, running tracks & turnkey sports facilities across India. Get a free quotation today."
  path="/"
  jsonLd={faqLd}
>
  <!-- HERO -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true">
      <img src={u(pageImages.heroBg, 1920, 1080)} alt="" class="hero-photo" fetchpriority="high" />
      <div class="hero-tint"></div>
      <div class="field-lines"></div>
      <div class="hero-glow"></div>
    </div>
    <div class="container hero-inner">
      <div class="hero-copy">
        <p class="pill" data-reveal><Icon name="shield" size={15} /> FIFA-Standard Surfaces · Turnkey Delivery</p>
        <h1 class="h-display" data-reveal data-delay="1">Best-Driven Turfs &amp; Sports Structures, Built to Last</h1>
        <p class="lead" data-reveal data-delay="2">India's turnkey partner for football turfs, multi-sport courts, running tracks and complete sports complexes, engineered to international standards and delivered end to end.</p>
        <div class="hero-cta" data-reveal data-delay="3">
          <a href="/contact" class="btn btn-primary btn-lg">Get a Free Quotation</a>
          <a href={whatsappLink()} class="btn btn-ghost btn-lg" target="_blank" rel="noopener"><Icon name="whatsapp" size={20} /> Chat on WhatsApp</a>
        </div>
        <div class="hero-trust" data-reveal data-delay="4">
          <span><Icon name="check" size={16} /> 500+ projects</span>
          <span><Icon name="check" size={16} /> PAN-India</span>
          <span><Icon name="check" size={16} /> Warranty-backed materials</span>
        </div>
      </div>
      <div class="hero-card" data-reveal data-delay="2">
        <div class="hero-card-inner">
          <p class="eyebrow">Fast Enquiry</p>
          <h3>Get a layout &amp; fixed quote</h3>
          <ul>
            <li><Icon name="check" size={18} /> Free site consultation</li>
            <li><Icon name="check" size={18} /> Transparent, fixed costing</li>
            <li><Icon name="check" size={18} /> On-time, play-ready handover</li>
          </ul>
          <a href="/contact" class="btn btn-primary">Request My Quote</a>
          <div class="hero-card-img"><RemoteImage id={pageImages.heroCard} alt="Artificial football turf installed by AV Sports and Infrastructure" w={640} h={360} eager={true} /></div>
        </div>
      </div>
    </div>
  </section>

  <!-- STATS -->
  <section class="stats-strip">
    <div class="container grid cols-4">
      {stats.map((s, i) => (
        <div class="stat" data-reveal data-delay={i}>
          <span class="stat-value">{s.value}</span>
          <span class="stat-label">{s.label}</span>
        </div>
      ))}
    </div>
  </section>

  <!-- SERVICES -->
  <section class="section">
    <div class="container">
      <div class="section-head" data-reveal>
        <p class="eyebrow">What We Build</p>
        <h2 class="section-title">Complete sports infrastructure, one accountable team</h2>
        <p class="lead">From a single turf to a full complex, design, civil work, surfacing, drainage, fencing and lighting, all under one roof.</p>
      </div>
      <div class="grid cols-3">
        {services.map((s, i) => (
          <ServiceCard slug={s.slug} title={s.title} short={s.short} icon={s.icon} img={serviceImages[s.slug]?.[0]} delay={i % 3} />
        ))}
      </div>
    </div>
  </section>

  <!-- WHY US -->
  <section class="section why">
    <div class="container why-grid">
      <div class="why-copy" data-reveal>
        <p class="eyebrow">Why AV Sports</p>
        <h2 class="section-title">Engineering you can stand on</h2>
        <p class="lead">We build to published performance specs and hand over on time. No shortcuts, no surprises.</p>
        <a href="/about" class="btn btn-ghost">About Our Work <Icon name="arrow" size={16} /></a>
      </div>
      <div class="why-list">
        {whyUs.map((w, i) => (
          <div class="why-item" data-reveal data-delay={i}>
            <span class="icon-badge"><Icon name="check" size={22} /></span>
            <div><h3>{w.title}</h3><p>{w.body}</p></div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- PROCESS -->
  <section class="section process">
    <div class="container">
      <div class="section-head center" data-reveal>
        <p class="eyebrow">How It Works</p>
        <h2 class="section-title">From site survey to first whistle</h2>
      </div>
      <div class="grid cols-4">
        {processSteps.map((p, i) => (
          <div class="step" data-reveal data-delay={i}>
            <span class="step-n">{p.n}</span>
            <h3>{p.title}</h3>
            <p>{p.body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  /* HERO */
  .hero { position: relative; overflow: hidden; padding-block: clamp(3rem, 8vw, 7rem); }
  .hero-bg { position: absolute; inset: 0; z-index: -1; background: linear-gradient(135deg, var(--forest) 0%, var(--forest-700) 50%, #0a5027 100%); overflow: hidden; }
  :root[data-theme='dark'] .hero-bg { background: linear-gradient(135deg, #021a0c 0%, #073018 55%, #0a4020 100%); }
  .hero-photo { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; opacity: 0.38; }
  :root[data-theme='dark'] .hero-photo { opacity: 0.28; }
  .hero-tint { position: absolute; inset: 0; background: linear-gradient(110deg, var(--forest) 8%, rgba(1,59,27,0.72) 45%, rgba(10,80,39,0.4) 100%); }
  :root[data-theme='dark'] .hero-tint { background: linear-gradient(110deg, #021a0c 8%, rgba(2,20,10,0.8) 45%, rgba(10,64,32,0.5) 100%); }
  .hero-card-img { margin-top: 1.1rem; height: 150px; border-radius: 12px; overflow: hidden; }
  .hero-card-img :global(.remote-img) { height: 150px; }
  .field-lines { position: absolute; inset: 0; opacity: 0.5;
    background-image:
      linear-gradient(rgba(255,255,255,0.05) 1px, transparent 1px),
      linear-gradient(90deg, rgba(255,255,255,0.05) 1px, transparent 1px);
    background-size: 60px 60px; mask-image: radial-gradient(ellipse 80% 80% at 70% 30%, #000 40%, transparent 100%); }
  .hero-glow { position: absolute; width: 600px; height: 600px; right: -140px; top: -180px; background: radial-gradient(circle, rgba(68,192,26,0.5), transparent 60%); filter: blur(16px); animation: float 9s ease-in-out infinite; }
  @keyframes float { 0%,100% { transform: translateY(0); } 50% { transform: translateY(26px); } }
  @media (prefers-reduced-motion: reduce) { .hero-glow { animation: none; } }

  .hero-inner { display: grid; grid-template-columns: 1.25fr 0.85fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: center; }
  .hero-copy .pill { background: rgba(255,255,255,0.12); color: #cdebc0; margin-bottom: 1.3rem; }
  .hero-copy h1 { color: #fff; margin-bottom: 1.2rem; }
  .hero-copy .lead { color: #d7ecdb; margin-bottom: 1.8rem; }
  .hero-cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-bottom: 1.6rem; }
  .hero-cta .btn-ghost { color: #fff; border-color: rgba(255,255,255,0.35); }
  .hero-cta .btn-ghost:hover { border-color: var(--grass); color: #fff; background: rgba(68,192,26,0.16); }
  .hero-trust { display: flex; gap: 1.2rem; flex-wrap: wrap; color: #bfdcc5; font-size: 0.9rem; font-weight: 600; }
  .hero-trust span { display: inline-flex; align-items: center; gap: 0.35rem; }
  .hero-trust :global(svg) { color: var(--grass-300); }

  .hero-card { position: relative; }
  .hero-card-inner { background: var(--surface); border-radius: var(--radius-lg); padding: clamp(1.4rem, 2.5vw, 1.9rem); box-shadow: var(--shadow-lg); border: 1px solid var(--border); }
  .hero-card .eyebrow { margin-bottom: 0.4rem; }
  .hero-card h3 { font-size: 1.4rem; margin-bottom: 1rem; text-transform: none; }
  .hero-card ul { list-style: none; padding: 0; margin: 0 0 1.3rem; display: grid; gap: 0.6rem; }
  .hero-card li { display: flex; align-items: center; gap: 0.6rem; font-size: 0.96rem; color: var(--text-soft); }
  .hero-card li :global(svg) { color: var(--grass-600); flex-shrink: 0; }
  :root[data-theme='dark'] .hero-card li :global(svg) { color: var(--grass-300); }
  .hero-card .btn { width: 100%; justify-content: center; }
  .img-slot { margin-top: 1.1rem; height: 120px; border-radius: 12px; display: grid; place-items: center; text-align: center; font-size: 0.8rem; color: var(--muted); border: 1.5px dashed var(--border); background: repeating-linear-gradient(45deg, var(--surface-2), var(--surface-2) 10px, transparent 10px, transparent 20px); }

  @media (max-width: 880px) { .hero-inner { grid-template-columns: 1fr; } .hero-card { max-width: 440px; } }

  /* STATS */
  .stats-strip { background: var(--forest); color: #fff; }
  :root[data-theme='dark'] .stats-strip { background: var(--surface-2); }
  .stats-strip .container { padding-block: clamp(1.6rem, 3vw, 2.4rem); }
  .stat { text-align: center; border-right: 1px solid rgba(255,255,255,0.14); }
  .stat:last-child { border-right: none; }
  :root[data-theme='dark'] .stat { border-color: var(--border); }
  .stat-value { display: block; font-family: var(--font-display); font-weight: 900; font-size: clamp(2rem, 4vw, 3rem); color: var(--grass-300); line-height: 1; }
  .stat-label { display: block; margin-top: 0.4rem; font-size: 0.85rem; letter-spacing: 0.08em; text-transform: uppercase; color: #cfe0d2; }
  :root[data-theme='dark'] .stat-label { color: var(--text-soft); }
  @media (max-width: 620px) { .stat { border-right: none; border-bottom: 1px solid rgba(255,255,255,0.14); padding-bottom: 1rem; } .stat:last-child { border-bottom: none; } }

  /* WHY */
  .why-grid { display: grid; grid-template-columns: 0.9fr 1.1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .why-copy { position: sticky; top: 100px; }
  .why-copy .btn { margin-top: 1.4rem; }
  .why-list { display: grid; gap: 1rem; }
  .why-item { display: flex; gap: 1rem; background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius); padding: 1.3rem 1.4rem; box-shadow: var(--shadow); transition: transform 0.3s var(--ease), border-color 0.3s; }
  .why-item:hover { transform: translateX(4px); border-color: color-mix(in srgb, var(--grass) 50%, var(--border)); }
  .why-item h3 { font-size: 1.1rem; text-transform: none; margin-bottom: 0.25rem; }
  .why-item p { color: var(--text-soft); font-size: 0.95rem; }
  @media (max-width: 820px) { .why-grid { grid-template-columns: 1fr; } .why-copy { position: static; } }

  /* PROCESS */
  .process { background: var(--surface-2); }
  .step { background: var(--surface); border: 1px solid var(--border); border-radius: var(--radius-lg); padding: 1.6rem 1.4rem; position: relative; box-shadow: var(--shadow); transition: transform 0.3s var(--ease); }
  .step:hover { transform: translateY(-6px); }
  .step-n { font-family: var(--font-display); font-weight: 900; font-size: 2.6rem; color: color-mix(in srgb, var(--grass) 45%, transparent); line-height: 1; display: block; margin-bottom: 0.6rem; }
  .step h3 { font-size: 1.1rem; text-transform: none; margin-bottom: 0.4rem; }
  .step p { color: var(--text-soft); font-size: 0.94rem; }
</style>
