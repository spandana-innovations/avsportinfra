---
import Base from '../../layouts/Base.astro';
import Icon from '../../components/Icon.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import CTABand from '../../components/CTABand.astro';
import { services } from '../../data/site';
import { serviceImages, u } from '../../data/images';
---
<Base
  title="Sports Infrastructure Services in India"
  description="Football turfs, cricket nets, courts, running tracks, drainage, floodlighting and turnkey sports projects, all built by AV Sports and Infrastructure."
  path="/services"
>
  <section class="page-hero">
    <div class="page-hero-bg" aria-hidden="true"><img class="hero-fade" src={u(serviceImages['football-turf'][0], 1600, 700)} alt="" /><div class="hero-glow"></div></div>
    <div class="container">
      <p class="pill" data-reveal><Icon name="layers" size={15} /> Full-Service Sports Builder</p>
      <h1 class="h-display" data-reveal data-delay="1">Complete Sports Infrastructure Services</h1>
      <p class="lead" data-reveal data-delay="2">From a single turf to a full complex, we deliver every layer of a sports facility, ground works, drainage, surfacing, fencing and lighting, with one team accountable from start to finish.</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="grid cols-3">
        {services.map((s, i) => (
          <ServiceCard slug={s.slug} title={s.title} short={s.short} icon={s.icon} img={serviceImages[s.slug]?.[0]} delay={i % 3} />
        ))}
      </div>
    </div>
  </section>

  <section class="section company-copy">
    <div class="container prose" data-reveal>
      <h2 class="section-title">A sports infrastructure company built for India</h2>
      <p>AV Sports and Infrastructure is a <strong>Sports Infrastructure Company in India</strong>, a turnkey <strong>Sports Infrastructure Construction Company</strong> and <strong>Sports Infrastructure Development Company</strong> delivering football turfs, courts, running tracks, sports flooring, swimming pools and complete complexes. As a <strong>Sports Ground Construction Company</strong>, <strong>Sports Facility Construction Company</strong> and <strong>Sports Ground Development Company</strong>, we work PAN-India from our Mumbai base, a <strong>Sports Infrastructure Company in Mumbai</strong> serving the whole country, the <strong>sports infrastructure company India</strong> trusts for turnkey builds.</p>
      <p>We are <strong>Sports Infrastructure Contractors</strong> and <strong>Sports Facility Construction Contractors</strong> offering <strong>Sports Facility Design and Construction</strong> and <strong>Sports Infrastructure Design and Build</strong>, a single accountable <strong>sports infrastructure contractor india</strong> and <strong>sports ground construction contractor</strong> from survey to handover. As <strong>Sports Ground Developers in India</strong> and <strong>Sports Turf Contractors</strong> (<strong>Sports Turf Contractors India</strong>), we deliver <strong>Sports Turf Installation</strong> and <strong>India Turf Construction</strong> using <strong>Artificial Grass for Sports Grounds</strong>.</p>
      <p>Clients looking for <strong>Sports Infrastructure Suppliers in India</strong>, <strong>Sports Infrastructure Manufacturers in India</strong> or complete <strong>Sports Infrastructure Solutions</strong> work with one partner that supplies and installs, sourcing materials from established manufacturers and delivering the finished ground. It is why we are chosen among the <strong>Top Sports Infrastructure Companies in India</strong> and aim to be the <strong>Best Sports Infrastructure Company in India</strong> for every client we build for.</p>
    </div>
  </section>

  <CTABand />
</Base>

<style>
  .page-hero { position: relative; overflow: hidden; color: #fff; padding-block: clamp(2.6rem, 6vw, 4.5rem); }
  .page-hero-bg { position: absolute; inset: 0; z-index: -1; background: linear-gradient(135deg, var(--forest), var(--forest-700) 60%, #0a5027); }
  :root[data-theme='dark'] .page-hero-bg { background: linear-gradient(135deg, #021a0c, #073018 60%, #0a4020); }
  .page-hero .hero-glow { position: absolute; width: 480px; height: 480px; right: -120px; top: -160px; background: radial-gradient(circle, rgba(68,192,26,0.4), transparent 62%); filter: blur(14px); }
  .page-hero .pill { background: rgba(255,255,255,0.12); color: #cdebc0; margin-bottom: 1.2rem; }
  .company-copy { background: var(--surface-2); }
  .company-copy .prose { max-width: 75ch; }
  .company-copy .prose h2 { margin-bottom: 1rem; }
  .company-copy .prose p { color: var(--text-soft); margin-bottom: 1rem; line-height: 1.75; }
  .company-copy .prose strong { color: var(--text); font-weight: 600; }
  .page-hero h1 { color: #fff; margin-bottom: 1rem; }
  .page-hero .lead { color: #d7ecdb; max-width: 64ch; }
</style>
